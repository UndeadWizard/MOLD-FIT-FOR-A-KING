### TYPES
types mfk_great_law_types
{
	# A non-collapsing section header: a divider with a centred title
	type mfk_je_section_header = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		margin_top = 6

		divider_clean = {
			parentanchor = hcenter
			size = { 500 3 }
		}

		textbox = {
			parentanchor = hcenter
			size = { 520 34 }
			align = center|nobaseline
			default_format = "#title"
			using = fontsize_xl
			block "header_text" {
				raw_text = ""
			}
		}
	}

	type mfk_nation_chief_tile = widget {
		size = { 84 110 }
		datacontext = "[Scope.GetCharacter]"
		visible = "[Scope.GetCharacter.IsValid]"

		character_portrait_medium = {
			datacontext = "[Scope.AccessCharacter]"
			parentanchor = hcenter
			position = { 0 4 }
			using = tooltip_es
			blockoverride "show_hat" {}
			blockoverride "highlight" {}
			blockoverride "rank_icon" {}
		}

		### Loyalty badge
		widget = {
			size = { 24 24 }
			parentanchor = top|right
			position = { -2 2 }
			tooltip = "LOYALTY_BREAKDOWN"

			icon = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint(Character.GetLoyalty, '(CFixedPoint)75')]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/generic_icons/approval_icon.dds"
			}
			icon = {
				visible = "[Between_CFixedPoint(Character.GetLoyalty, '(CFixedPoint)25', '(CFixedPoint)75')]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/generic_icons/maybe_icon.dds"
			}
			icon = {
				visible = "[LessThanOrEqualTo_CFixedPoint(Character.GetLoyalty, '(CFixedPoint)25')]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds"
			}
		}

		### Nation
		textbox = {
			parentanchor = bottom|hcenter
			position = { 0 -4 }
			size = { 84 22 }
			align = center|nobaseline
			text = "[Character.GetCustom('mfk_nation_name')]"
			default_format = "#v"
			using = fontsize_small
			elide = right
		}
	}

	# Panel listing the nations under the Great Law, opened from the lens toolbar button
	type mfk_great_law_panel = default_block_window {
		name = "information_panel_bar"
		visible = "[GetVariableSystem.Exists('mfk_great_law_open')]"

		blockoverride "animation_state_block" {
			state = {
				name = _show
				on_start = "[InformationPanelBar.ClosePanel]"
				on_start = "[MapListPanelManager.CloseCurrentPanel]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/budget"
				}
			}
			state = {
				name = _hide
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/budget_stop"
				}
			}
		}

		blockoverride "close_great_law_panel" {}

		blockoverride "entire_back_button" {}

		blockoverride "header_close_button" {
			onclick = "[GetVariableSystem.Clear('mfk_great_law_open')]"
		}

		blockoverride "window_header_name" {
			text = "MFK_GREAT_LAW_PANEL_TITLE"
		}

		blockoverride "fixed_top" {}

		blockoverride "scrollarea_content" {
			flowcontainer = {
				direction = vertical
				using = default_list_position
				margin_top = 10
				spacing = 4

				textbox = {
					parentanchor = hcenter
					size = { 520 28 }
					align = center|nobaseline
					text = "MFK_GREAT_LAW_NATIONS_HEADER"
					default_format = "#v"
					using = fontsize_medium
				}

				fixedgridbox = {
					parentanchor = hcenter
					datamodel = "[GetPlayer.MakeScope.GetList('mfk_great_law_list')]"
					datamodel_wrap = 6
					flipdirection = yes
					addcolumn = 86
					addrow = 112

					background = {
						texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
						color = { 0.47 0.33 0.27 1 }
						alpha = 0.4

						modify_texture = {
							using = texture_velvet
						}
					}

					item = {
						mfk_nation_chief_tile = {}
					}
				}

				textbox = {
					parentanchor = hcenter
					size = { 520 26 }
					align = center|nobaseline
					text = "MFK_GREAT_LAW_MOVEMENT_LINE"
					tooltip = "MFK_GREAT_LAW_MOVEMENT_LINE_TT"
					using = fontsize_medium
				}

				textbox = {
					parentanchor = hcenter
					size = { 520 28 }
					align = center|nobaseline
					text = "MFK_UNALIGNED_NATIONS_HEADER"
					default_format = "#v"
					using = fontsize_medium
				}

				fixedgridbox = {
					parentanchor = hcenter
					datamodel = "[GetPlayer.MakeScope.GetList('mfk_unaligned_list')]"
					datamodel_wrap = 6
					flipdirection = yes
					addcolumn = 86
					addrow = 112

					background = {
						texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
						color = { 0.47 0.33 0.27 1 }
						alpha = 0.4

						modify_texture = {
							using = texture_velvet
						}
					}

					item = {
						mfk_nation_chief_tile = {}
					}
				}

				textbox = {
					parentanchor = hcenter
					size = { 520 26 }
					align = center|nobaseline
					text = "MFK_DEHORNERS_MOVEMENT_LINE"
					tooltip = "MFK_DEHORNERS_MOVEMENT_LINE_TT"
					using = fontsize_medium
				}
			}
		}
	}

	# Lens toolbar button, shown only to the Tadodaho's country
	type mfk_great_law_button = icon {
		size = { 46 46 }
		texture = "gfx/interface/backgrounds/round_button_bg.dds"
		parentanchor = bottom|hcenter
		datacontext = "[GetScriptedGui('mfk_great_law_sgui')]"
		visible = "[And(GetPlayer.IsValid, ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"

		button_icon_round = {
			parentanchor = center
			size = { 40 40 }
			onclick = "[InformationPanelBar.ClosePanel]"
			onclick = "[MapListPanelManager.CloseCurrentPanel]"
			onclick = "[GetVariableSystem.Toggle('mfk_great_law_open')]"
			tooltip = "MFK_GREAT_LAW_BUTTON_TT"
			using = tooltip_ws

			blockoverride "icon" {
				texture = "gfx/interface/icons/faction_icons/faction_grand_hoyaneh.dds"
			}
			blockoverride "icon_size" {
				size = { 30 30 }
			}
		}
	}
}
